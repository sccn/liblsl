# Doxygen settings for the Sphinx API reference (docs/conf.py runs this; breathe reads the XML).
# The standalone HTML / Qt help documentation uses docs/Doxyfile.

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = liblsl_api
PROJECT_BRIEF          = "Multi-modal time-synched data transmission over local network"
OUTPUT_DIRECTORY       = liblsl_api
FULL_PATH_NAMES        = NO
DISTRIBUTE_GROUP_DOC   = YES
INLINE_SIMPLE_STRUCTS  = YES
WARN_IF_UNDOCUMENTED   = NO
SHOW_NAMESPACES        = NO
INPUT                  = ../include ../include/lsl/
JAVADOC_AUTOBRIEF      = YES
FILE_PATTERNS          = *.h
EXCLUDE_SYMBOLS        = lslboost
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
ENABLE_PREPROCESSING   = YES
PREDEFINED             = LIBLSL_C_API LSL_DOXYGEN
GENERATE_XML           = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
HAVE_DOT               = NO
